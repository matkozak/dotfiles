# This is Git's per-user configuration file.
[user]
name = Mateusz Kozak
email = 19314272+matkozak@users.noreply.github.com
[core]
	editor = nvim
[init]
	defaultBranch = main
# GitHub auth comes from gh; other hosts use the system default helper
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
